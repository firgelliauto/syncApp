# Use permanent Shopify admin domains, not storefront domains.
MAIN_SHOP=firgelliautomation.myshopify.com
CHILD_SHOP=firgelli1.myshopify.com

# Dev Dashboard app credentials; keep real values only in ignored .env or host secrets.
MAIN_CLIENT_ID=
MAIN_CLIENT_SECRET=
CHILD_CLIENT_ID=
CHILD_CLIENT_SECRET=
WEBHOOK_OLD_CLIENT_SECRET=
SYNC_CONTROL_USER_ID=

# Copy the Shopify Location GIDs returned by: node src/audit.mjs locations
MAIN_LOCATION_ID=
CHILD_LOCATION_ID=

PUBLIC_BASE_URL=
PORT=8080
SYNC_ENABLED=false
ALLOW_INVENTORY_WRITES=false
STATE_DB=./data/inventory-sync.sqlite

# Deployed Cloudflare Worker URL and long random operator token for cloud-bootstrap.mjs.
CLOUDFLARE_WORKER_URL=
ADMIN_TOKEN=
